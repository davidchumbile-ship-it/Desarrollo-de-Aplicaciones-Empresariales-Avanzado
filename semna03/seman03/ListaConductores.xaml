<Window x:Class="seman03.ListaConductores"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mantenimiento - Lista de Conductores" Height="500" Width="750"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Listado de Conductores y Unidades Asignadas" FontSize="20" FontWeight="Bold"
                   Foreground="#1F2937" Margin="0,0,0,15"/>

        <!-- Formulario Rápido de Registro de Conductor -->
        <GroupBox Grid.Row="1" Header="Registrar Nuevo Conductor" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <TextBlock Text="Nombre Conductor:" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtNombreConductor" Margin="0,3,0,0" Height="26" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="Licencia:" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtLicencia" Margin="0,3,0,0" Height="26" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                    <TextBlock Text="Placa:" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtPlaca" Margin="0,3,0,0" Height="26" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="5">
                    <TextBlock Text="Peso Máximo:" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtPesoMaximo" Margin="0,3,0,0" Height="26" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                    <TextBlock Text="Peso Vacío:" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtPesoVacio" Margin="0,3,0,0" Height="26" VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnAgregar" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                        Content="Agregar Conductor" Height="30" Margin="5,15,5,0"
                        Background="#2563EB" Foreground="White" FontWeight="Bold"
                        Click="btnAgregar_Click"/>
            </Grid>
        </GroupBox>

        <!-- Tabla / DataGrid -->
        <DataGrid x:Name="dgConductores" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderBrush="#E5E7EB" RowHeight="28">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre Conductor" Binding="{Binding NombreConductor}" Width="2*"/>
                <DataGridTextColumn Header="Licencia" Binding="{Binding Licencia}" Width="1.2*"/>
                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="1.2*"/>
                <DataGridTextColumn Header="Peso Máximo" Binding="{Binding PesoMaximo}" Width="1.2*"/>
                <DataGridTextColumn Header="Peso Vacío" Binding="{Binding PesoVacio}" Width="1.2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cerrar" Width="100" Height="30" Background="#6B7280" Foreground="White"
                    Click="btnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
