<Window x:Class="seman03.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Inicio de Sesión - Sistema de Gestión" Height="340" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Border Background="#F3F4F6" Padding="25">
        <Border Background="White" CornerRadius="8" Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Color="#CCCCCC" Opacity="0.5" Direction="270" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Acceso al Sistema" FontSize="20" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ingrese sus credenciales para continuar" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Usuario:" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtUsuario" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <TextBlock Text="Contraseña:" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="txtPassword" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                </StackPanel>

                <Button x:Name="btnIngresar" Content="Ingresar" Height="34" Grid.Row="3"
                        Background="#2563EB" Foreground="White" FontWeight="Bold"
                        Cursor="Hand" Click="btnIngresar_Click"/>

                <TextBlock Grid.Row="4" Text="(Demo: admin / 1234)" FontSize="11" Foreground="#9CA3AF"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Border>
</Window>
