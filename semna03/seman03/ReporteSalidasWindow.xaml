<Window x:Class="seman03.ReporteSalidasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Reporte - Listado de Salidas" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Reporte de Salidas de Vehículos" FontSize="20" FontWeight="Bold"
                   Foreground="#1F2937" Margin="0,0,0,15"/>

        <!-- Filtros de Búsqueda -->
        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Nombre Transportista:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="#374151" Margin="0,0,10,0"/>

                <TextBox x:Name="txtFiltroTransportista" Grid.Column="1" Height="30"
                         VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,10,0"/>

                <Button x:Name="btnBuscar" Grid.Column="2" Content="Buscar" Width="90" Height="30"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" Margin="0,0,8,0"
                        Cursor="Hand" Click="btnBuscar_Click"/>

                <Button x:Name="btnLimpiar" Grid.Column="3" Content="Limpiar" Width="80" Height="30"
                        Background="#E5E7EB" Foreground="#1F2937" FontWeight="SemiBold"
                        Cursor="Hand" Click="btnLimpiar_Click"/>
            </Grid>
        </Border>

        <!-- Tabla con los campos solicitados -->
        <DataGrid x:Name="dgSalidas" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderBrush="#E5E7EB" RowHeight="28">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="100"/>
                <DataGridTextColumn Header="Peso" Binding="{Binding Peso}" Width="90"/>
                <DataGridTextColumn Header="Tipo Auto" Binding="{Binding TipoAuto}" Width="140"/>
                <DataGridTextColumn Header="Nombre Transportista" Binding="{Binding NombreTransportista}" Width="2*"/>
                <DataGridTextColumn Header="Peso Ingreso" Binding="{Binding PesoIngreso}" Width="100"/>
                <DataGridTextColumn Header="Peso Salida" Binding="{Binding PesoSalida}" Width="100"/>
                <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding FechaYHora}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Barra inferior -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="lblContador" Text="Total de registros: 0" VerticalAlignment="Center"
                       Foreground="#6B7280" FontWeight="SemiBold"/>
            <Button Content="Cerrar" Width="100" Height="30" HorizontalAlignment="Right"
                    Background="#6B7280" Foreground="White" Click="btnCerrar_Click"/>
        </Grid>
    </Grid>
</Window>
