<Window x:Class="seman03.RegistroCamion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mantenimiento - Registro de Camiones" Height="520" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Registro y Mantenimiento de Camiones" FontSize="20" FontWeight="Bold"
                   Foreground="#1F2937" Margin="0,0,0,12"/>

        <GroupBox Grid.Row="1" Header="Datos del Camión" Padding="10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="45"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Placa:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtPlaca" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="Peso Máximo:" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtPesoMaximo" Grid.Row="0" Grid.Column="4" Height="28" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="Peso Vacío:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtPesoVacio" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="5,0"/>

                <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                    <Button x:Name="btnLimpiar" Content="Limpiar" Width="80" Height="30" Margin="0,0,8,0"
                            Background="#E5E7EB" Foreground="#1F2937" FontWeight="SemiBold" Click="btnLimpiar_Click"/>
                    <Button x:Name="btnGuardar" Content="Guardar" Width="100" Height="30"
                            Background="#2563EB" Foreground="White" FontWeight="Bold" Click="btnGuardar_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Camiones Registrados" Padding="5">
            <DataGrid x:Name="dgCamiones" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderBrush="#E5E7EB" RowHeight="26">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="1.5*"/>
                    <DataGridTextColumn Header="Peso Máximo" Binding="{Binding PesoMaximo}" Width="2*"/>
                    <DataGridTextColumn Header="Peso Vacío" Binding="{Binding PesoVacio}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>