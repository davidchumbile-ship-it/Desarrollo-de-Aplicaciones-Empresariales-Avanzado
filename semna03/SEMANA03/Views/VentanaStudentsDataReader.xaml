<Window x:Class="SEMANA03.Views.VentanaStudentsDataReader"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estudiantes - Modo Conectado (SqlDataReader y Objetos)" Height="520" Width="680"
        WindowStartupLocation="CenterScreen" Background="#F8F9FA">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="#107C41" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Lista de Estudiantes (Modo Conectado)" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Barra de acciones -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnCargar" Content="🔄 Cargar con DataReader" Click="btnCargar_Click"
                    Padding="12,6" Background="#107C41" Foreground="White" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnLimpiar" Content="Limpiar" Click="btnLimpiar_Click"
                    Padding="12,6" Margin="10,0,0,0" Background="#E0E0E0" Foreground="#333333"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="dgStudents" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True"
                  AlternatingRowBackground="#F0F8F3" RowHeight="28" GridLinesVisibility="Horizontal"
                  BorderBrush="#CCCCCC" BorderThickness="1" HeadersVisibility="Column"/>

        <!-- Barra de estado -->
        <StatusBar Grid.Row="3" Margin="0,8,0,0" Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="txtEstado" Text="Listo para cargar datos." Foreground="#555555" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
