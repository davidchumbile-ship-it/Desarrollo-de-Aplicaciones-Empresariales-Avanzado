<Window x:Class="SEMANA03.Views.VentanaBuscarStudents"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar Estudiantes por Nombre (SqlDataReader)" Height="540" Width="720"
        WindowStartupLocation="CenterScreen" Background="#F8F9FA">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="#5C2D91" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Búsqueda de Estudiantes (Modo Conectado)" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Barra de búsqueda -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Buscar por nombre:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <TextBox x:Name="txtBuscar" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0" KeyDown="txtBuscar_KeyDown"/>
                <Button x:Name="btnBuscar" Grid.Column="2" Content="🔍 Buscar" Click="btnBuscar_Click"
                        Padding="16,6" Background="#5C2D91" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                <Button x:Name="btnMostrarTodos" Grid.Column="3" Content="Mostrar Todos" Click="btnMostrarTodos_Click"
                        Padding="12,6" Background="#E0E0E0" Foreground="#333333"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid x:Name="dgResultados" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True"
                  AlternatingRowBackground="#F7F3FB" RowHeight="28" GridLinesVisibility="Horizontal"
                  BorderBrush="#CCCCCC" BorderThickness="1" HeadersVisibility="Column"/>

        <!-- Barra de estado -->
        <StatusBar Grid.Row="3" Margin="0,8,0,0" Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="txtEstado" Text="Ingrese un nombre o presione Buscar / Mostrar Todos." Foreground="#555555" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
