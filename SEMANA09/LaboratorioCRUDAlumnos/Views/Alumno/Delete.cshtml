@model LaboratorioCRUDAlumnos.Models.AlumnoModel
@{
    ViewBag.Title = "Eliminar alumno";
}

<h2>Eliminar alumno</h2>

<div class="alert alert-warning mt-3">
    ¿Está seguro de que desea eliminar a este alumno?
</div>

<div class="card col-md-6">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Id</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Nombres</dt>
            <dd class="col-sm-8">@Model.Nombres</dd>

            <dt class="col-sm-4">Apellidos</dt>
            <dd class="col-sm-8">@Model.Apellidos</dd>

            <dt class="col-sm-4">Edad</dt>
            <dd class="col-sm-8">@Model.Edad</dd>

            <dt class="col-sm-4">Correo</dt>
            <dd class="col-sm-8">@Model.Correo</dd>
        </dl>
    </div>
</div>

@using (Html.BeginForm("Delete", "Alumno", new { id = Model.Id }, FormMethod.Post, new { @class = "mt-3" }))
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger" onclick="return confirm('¿Confirma la eliminación del alumno?');">Sí, eliminar</button>
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
}
