@model LaboratorioCRUDAlumnos.Models.AlumnoModel
@{
    ViewBag.Title = "Detalles del alumno";
}

<h2>Detalles del alumno</h2>

<div class="card col-md-6 mt-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Id</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Nombres</dt>
            <dd class="col-sm-8">@Model.Nombres</dd>

            <dt class="col-sm-4">Apellidos</dt>
            <dd class="col-sm-8">@Model.Apellidos</dd>

            <dt class="col-sm-4">Edad</dt>
            <dd class="col-sm-8">@Model.Edad</dd>

            <dt class="col-sm-4">Correo</dt>
            <dd class="col-sm-8">@Model.Correo</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-secondary" })
</div>
