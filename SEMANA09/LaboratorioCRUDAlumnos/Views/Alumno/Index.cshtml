@model List<LaboratorioCRUDAlumnos.Models.AlumnoModel>
@{
    ViewBag.Title = "Listado de alumnos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Listado de alumnos</h2>
    @Html.ActionLink("+ Nuevo alumno", "Create", null, new { @class = "btn btn-primary" })
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Nombres</th>
            <th>Apellidos</th>
            <th>Edad</th>
            <th>Correo</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No hay alumnos registrados.</td>
            </tr>
        }
        @foreach (var alumno in Model)
        {
            <tr>
                <td>@alumno.Id</td>
                <td>@alumno.Nombres</td>
                <td>@alumno.Apellidos</td>
                <td>@alumno.Edad</td>
                <td>@alumno.Correo</td>
                <td class="text-end">
                    @Html.ActionLink("Detalles", "Details", new { id = alumno.Id }, new { @class = "btn btn-sm btn-info" })
                    @Html.ActionLink("Editar", "Edit", new { id = alumno.Id }, new { @class = "btn btn-sm btn-warning" })
                    @Html.ActionLink("Eliminar", "Delete", new { id = alumno.Id }, new { @class = "btn btn-sm btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted small">Total de alumnos en sesión: @Model.Count</p>
