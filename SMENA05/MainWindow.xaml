<Window x:Class="SEMANA04.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEMANA04" Height="360" Width="450"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Menu">
                <MenuItem Header="Productos" Click="MenuProductos_Click"/>
                <MenuItem Header="Categorias" Click="MenuCategorias_Click"/>
                <MenuItem Header="Proveedores" Click="MenuProveedoresGeneral_Click"/>
                <MenuItem Header="Buscar Proveedores" Click="MenuProveedoresBuscar_Click"/>
                <MenuItem Header="Detalles Pedidos" Click="MenuDetallesPedidos_Click"/>
                <MenuItem Header="CRUD Proveedores" Click="MenuCrudProveedores_Click"/>
                <Separator/>
                <MenuItem Header="Salir" Click="MenuSalir_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="220">
                <Button Content="Productos" Height="30" Margin="0,4" Click="MenuProductos_Click"/>
                <Button Content="Categorias" Height="30" Margin="0,4" Click="MenuCategorias_Click"/>
                <Button Content="Proveedores" Height="30" Margin="0,4" Click="MenuProveedoresGeneral_Click"/>
                <Button Content="Buscar Proveedores" Height="30" Margin="0,4" Click="MenuProveedoresBuscar_Click"/>
                <Button Content="Detalles Pedidos" Height="30" Margin="0,4" Click="MenuDetallesPedidos_Click"/>
                <Button Content="CRUD Proveedores" Height="30" Margin="0,4" Click="MenuCrudProveedores_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
