<Window x:Class="SEMANA04.Views.VentanaCrudProveedores"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CRUD Proveedores" Height="600" Width="1000">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Nuevo" Width="80" Margin="0,0,10,0" Click="BtnNuevo_Click"/>
            <Button Content="Guardar" Width="80" Margin="0,0,10,0" Click="BtnGuardar_Click"/>
            <Button Content="Eliminar" Width="80" Margin="0,0,10,0" Click="BtnEliminar_Click"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ID:" Grid.Row="0" Grid.Column="0" Margin="5"/>
            <TextBox Name="txtId" Grid.Row="0" Grid.Column="1" Margin="5" IsEnabled="False"/>

            <TextBlock Text="Compañía:" Grid.Row="0" Grid.Column="2" Margin="5"/>
            <TextBox Name="txtCompania" Grid.Row="0" Grid.Column="3" Margin="5"/>

            <TextBlock Text="Contacto:" Grid.Row="0" Grid.Column="4" Margin="5"/>
            <TextBox Name="txtContacto" Grid.Row="0" Grid.Column="5" Margin="5"/>

            <TextBlock Text="Cargo:" Grid.Row="1" Grid.Column="0" Margin="5"/>
            <TextBox Name="txtCargo" Grid.Row="1" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Dirección:" Grid.Row="1" Grid.Column="2" Margin="5"/>
            <TextBox Name="txtDireccion" Grid.Row="1" Grid.Column="3" Margin="5"/>

            <TextBlock Text="Ciudad:" Grid.Row="1" Grid.Column="4" Margin="5"/>
            <TextBox Name="txtCiudad" Grid.Row="1" Grid.Column="5" Margin="5"/>

            <TextBlock Text="Región:" Grid.Row="2" Grid.Column="0" Margin="5"/>
            <TextBox Name="txtRegion" Grid.Row="2" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Cód. Postal:" Grid.Row="2" Grid.Column="2" Margin="5"/>
            <TextBox Name="txtCodPostal" Grid.Row="2" Grid.Column="3" Margin="5"/>

            <TextBlock Text="País:" Grid.Row="2" Grid.Column="4" Margin="5"/>
            <TextBox Name="txtPais" Grid.Row="2" Grid.Column="5" Margin="5"/>

            <TextBlock Text="Teléfono:" Grid.Row="3" Grid.Column="0" Margin="5"/>
            <TextBox Name="txtTelefono" Grid.Row="3" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Fax:" Grid.Row="3" Grid.Column="2" Margin="5"/>
            <TextBox Name="txtFax" Grid.Row="3" Grid.Column="3" Margin="5"/>
        </Grid>

        <DataGrid Name="dgProveedores" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="DgProveedores_SelectionChanged"/>
    </Grid>
</Window>
